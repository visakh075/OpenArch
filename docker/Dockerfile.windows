FROM fedora:40

LABEL maintainer="OpenArch Team"
LABEL description="Isolated Docker cross-compilation environment for building OpenArch on Windows x86_64"

# Install MinGW-w64 toolchain, precompiled Qt5 Windows libraries, SQLite3, CMake, NSIS and packaging tools
RUN dnf install -y \
    mingw64-gcc \
    mingw64-gcc-c++ \
    mingw64-binutils \
    mingw64-qt5-qtbase \
    mingw64-qt5-qtbase-devel \
    mingw64-qt5-qtsvg \
    mingw64-sqlite \
    mingw64-winpthreads \
    cmake \
    qt5-qtbase-devel \
    qt5-qtsvg-devel \
    mingw32-nsis \
    mingw64-nsis \
    ninja-build \
    make \
    zip \
    unzip \
    file \
    && dnf clean all

WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "/workspace/docker/package-windows.sh"]
