{
    "name": "OpenArch Blueprint",
    "view": {
        "background": "#0b2545ff",
        "grid": {
            "enabled": true,
            "minorColor": "#13315cff",
            "majorColor": "#134074ff",
            "spacing": 20,
            "majorSpacing": 100,
            "lineWidth": 1
        }
    },
    "node": {
        "minWidth": 120,
        "minHeight": 50,
        "normal": {
            "background": "#13315cff",
            "border": "#8da9c4ff",
            "borderWidth": 2,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#eef4f8ff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#8da9c4ff", "size": 11, "bold": false, "align": "center" }
        },
        "hover": {
            "background": "#134074ff",
            "border": "#eef4f8ff",
            "borderWidth": 3,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ffffffff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#ffffffff", "size": 11, "bold": false, "align": "center" }
        },
        "selected": {
            "background": "#134074ff",
            "border": "#00f0ffff",
            "borderWidth": 4,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#00f0ffff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#eef4f8ff", "size": 11, "bold": false, "align": "center" }
        }
    },
    "container": {
        "minWidth": 220,
        "minHeight": 140,
        "normal": {
            "background": "#13315c2d",
            "border": "#8da9c4ff",
            "borderWidth": 2,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#8da9c423",
            "headerHeightPadding": 12,
            "title": { "color": "#eef4f8ff", "size": 14, "bold": true, "align": "left" }
        },
        "hover": {
            "background": "#13407437",
            "border": "#eef4f8ff",
            "borderWidth": 2,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#eef4f82d",
            "headerHeightPadding": 12,
            "title": { "color": "#ffffffff", "size": 14, "bold": true, "align": "left" }
        },
        "selected": {
            "background": "#1340743c",
            "border": "#00f0ffff",
            "borderWidth": 3,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#00f0ff32",
            "headerHeightPadding": 12,
            "title": { "color": "#00f0ffff", "size": 14, "bold": true, "align": "left" }
        }
    },
    "edge": {
        "preview": {
            "color": "#00f0ffff",
            "width": 2,
            "style": "dashed"
        },
        "normal": {
            "lineColor": "#8da9c4ff",
            "lineWidth": 2,
            "arrow": {
                "lineColor": "#8da9c4ff",
                "fillColor": "#8da9c4aa",
                "width": 14,
                "height": 10,
                "lineWidth": 2
            },
            "label": {
                "textColor": "#eef4f8ff",
                "backgroundColor": "#0b254500",
                "borderColor": "#134074ff",
                "borderWidth": 1,
                "fontSize": 11,
                "bold": false,
                "paddingX": 0,
                "paddingY": 0,
                "radius": 4,
                "offset": 8
            }
        },
        "hover": {
            "lineColor": "#eef4f8ff",
            "lineWidth": 3,
            "arrow": {
                "lineColor": "#eef4f8ff",
                "fillColor": "#eef4f8ff",
                "width": 16,
                "height": 12,
                "lineWidth": 2
            },
            "label": {
                "textColor": "#ffffffff",
                "backgroundColor": "#13315cff",
                "borderColor": "#eef4f8ff",
                "borderWidth": 1,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
        },
        "selected": {
            "lineColor": "#00f0ffff",
            "lineWidth": 4,
            "arrow": {
                "lineColor": "#00f0ffff",
                "fillColor": "#00f0ffff",
                "width": 18,
                "height": 14,
                "lineWidth": 3
            },
            "label": {
                "textColor": "#00f0ffff",
                "backgroundColor": "#0b2545ff",
                "borderColor": "#00f0ffff",
                "borderWidth": 2,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
        }
    },
    "port": {
        "inputColor": "#00f0ffff",
        "outputColor": "#8da9c4ff",
        "hoverColor": "#ffffffff",
        "radius": 6
    },
    "selection": {
        "outline": "#00f0ffff",
        "fill": "#00f0ff22"
    },
    "interaction": {
        "hoverOutline": "#ffffffff",
        "invalidConnection": "#ff4d6dff",
        "dropTarget": "#00f0ffff"
    }
}