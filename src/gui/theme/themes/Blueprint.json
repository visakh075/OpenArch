            "title": { "color": "#ffffff", "size": 14, "bold": true },
            "body": { "color": "#ffffff", "size": 11, "bold": false }
        },
        "selected": {
            "background": "#134074",
            "border": "#00f0ff",
            "borderWidth": 4,
            "radius": 4,
            "title": { "color": "#00f0ff", "size": 14, "bold": true },
