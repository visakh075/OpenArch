{
    "name": "OpenArch Blueprint",
    "view": {
        "background": "#0b2545",
        "grid": {
            "enabled": true,
            "minorColor": "#13315c",
            "majorColor": "#134074",
            "spacing": 20,
            "majorSpacing": 100
        }
    },
    "node": {
        "normal": {
            "background": "#13315cdd",
