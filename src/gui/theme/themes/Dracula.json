        "normal": {
            "lineColor": "#8be9fdff",
            "lineWidth": 2,
            "arrow": {
                "lineColor": "#8be9fdff",
                "fillColor": "#8be9fdaa",
                "width": 14,
                "height": 10,
                "lineWidth": 2
            },
            "label": {
