                "paddingY": 0,
                "radius": 4,
                "offset": 8
            }
        },
        "hover": {
            "lineColor": "#ff79c6ff",
            "lineWidth": 3,
            "arrow": {
                "lineColor": "#ff79c6ff",
                "fillColor": "#ff79c6ff",
                "width": 16,
                "height": 12,
                "lineWidth": 2
            },
            "label": {
                "textColor": "#ff79c6ff",
                "backgroundColor": "#343746ff",
                "borderColor": "#ff79c6ff",
                "borderWidth": 1,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
        },
        "selected": {
            "lineColor": "#50fa7bff",
            "lineWidth": 4,
            "arrow": {
                "lineColor": "#50fa7bff",
                "fillColor": "#50fa7bff",
                "width": 18,
                "height": 14,
                "lineWidth": 3
            },
            "label": {
                "textColor": "#50fa7bff",
                "backgroundColor": "#44475aff",
                "borderColor": "#50fa7bff",
                "borderWidth": 2,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
        }
