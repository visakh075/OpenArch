            "headerHeightPadding": 12,
            "title": { "color": "#ffffff", "size": 14, "bold": true, "align": "left" }
        },
        "hover": {
            "background": "#35353a37",
            "border": "#ffffffff",
            "borderWidth": 2,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#ffffff2d",
            "headerHeightPadding": 12,
            "title": { "color": "#ffffff", "size": 14, "bold": true, "align": "left" }
        },
        "selected": {
            "background": "#3a35203c",
            "border": "#ffcc00ff",
            "borderWidth": 3,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#ffcc0032",
            "headerHeightPadding": 12,
            "title": { "color": "#ffcc00", "size": 14, "bold": true, "align": "left" }
        }
