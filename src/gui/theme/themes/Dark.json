{
    "name": "OpenArch Dark",
    "view": {
        "background": "#202020",
        "grid": {
            "enabled": true,
            "minorColor": "#2a2a2a",
            "majorColor": "#353535",
            "spacing": 20,
            "majorSpacing": 100,
            "lineWidth": 1
        }
    },
    "node": {
        "minWidth": 120,
        "minHeight": 50,
        "normal": {
            "background": "#2d2d30ff",
            "border": "#6a95ffff",
            "borderWidth": 2,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ffffff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#d0d0d0", "size": 11, "bold": false, "align": "center" }
        },
        "hover": {
            "background": "#35353aff",
            "border": "#ffffffff",
            "borderWidth": 3,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ffffff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#ffffff", "size": 11, "bold": false, "align": "center" }
        },
        "selected": {
            "background": "#3a3520ff",
            "border": "#ffcc00ff",
            "borderWidth": 4,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ffcc00", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#ffffff", "size": 11, "bold": false, "align": "center" }
        }
    },
    "container": {
        "minWidth": 220,
        "minHeight": 140,
