                "width": 18,
                "height": 14,
                "lineWidth": 3
            },
            "label": {
                "textColor": "#ffcc00",
                "backgroundColor": "#3a3520",
                "borderColor": "#ffcc00",
                "borderWidth": 2,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
