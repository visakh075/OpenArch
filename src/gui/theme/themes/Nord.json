                "borderWidth": 1,
                "fontSize": 11,
                "bold": true,
                "paddingX": 6,
                "paddingY": 3,
                "radius": 4,
                "offset": 8
            }
        },
        "selected": {
            "lineColor": "#ebcb8bff",
            "lineWidth": 4,
            "arrow": {
                "lineColor": "#ebcb8bff",
                "fillColor": "#ebcb8bff",
                "width": 18,
                "height": 14,
                "lineWidth": 3
            },
            "label": {
                "textColor": "#ebcb8bff",
                "backgroundColor": "#434c5eff",
                "borderColor": "#ebcb8bff",
