        "minHeight": 50,
        "normal": {
            "background": "#3b4252ff",
            "border": "#88c0d0ff",
            "borderWidth": 2,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#eceff4ff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#d8dee9ff", "size": 11, "bold": false, "align": "center" }
        },
        "hover": {
            "background": "#434c5eff",
            "border": "#eceff4ff",
            "borderWidth": 3,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ffffffff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#eceff4ff", "size": 11, "bold": false, "align": "center" }
        },
        "selected": {
            "background": "#434c5eff",
            "border": "#ebcb8bff",
            "borderWidth": 4,
            "borderStyle": "solid",
            "radius": 8,
            "padding": 8,
            "title": { "color": "#ebcb8bff", "size": 14, "bold": true, "align": "center" },
            "body": { "color": "#eceff4ff", "size": 11, "bold": false, "align": "center" }
        }
    },
    "container": {
        "minWidth": 220,
        "minHeight": 140,
        "normal": {
            "background": "#3b42522d",
            "border": "#88c0d0ff",
            "borderWidth": 2,
