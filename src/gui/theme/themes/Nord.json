            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#88c0d023",
            "headerHeightPadding": 12,
            "title": { "color": "#eceff4ff", "size": 14, "bold": true, "align": "left" }
        },
        "hover": {
            "background": "#434c5e37",
            "border": "#eceff4ff",
            "borderWidth": 2,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#eceff42d",
            "headerHeightPadding": 12,
            "title": { "color": "#ffffffff", "size": 14, "bold": true, "align": "left" }
        },
        "selected": {
            "background": "#434c5e3c",
            "border": "#ebcb8bff",
            "borderWidth": 3,
            "borderStyle": "dashed",
            "dashPattern": [6.0, 4.0],
            "radius": 8,
            "padding": 8,
            "headerBackground": "#ebcb8b32",
            "headerHeightPadding": 12,
            "title": { "color": "#ebcb8bff", "size": 14, "bold": true, "align": "left" }
