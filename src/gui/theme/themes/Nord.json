{
    "name": "OpenArch Nord",
    "view": {
        "background": "#2e3440ff",
        "grid": {
            "enabled": true,
            "minorColor": "#3b4252ff",
            "majorColor": "#434c5eff",
            "spacing": 20,
            "majorSpacing": 100,
            "lineWidth": 1
        }
    },
    "node": {
